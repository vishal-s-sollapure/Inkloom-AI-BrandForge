# =============================================================================
# BrandForge — Environment Configuration Template
# =============================================================================
# Copy this file to `.env` for local development.
# In Netlify production, configure these variables in Site Settings > Environment variables.
# NEVER commit your actual `.env` file containing secrets to version control.
# =============================================================================

# 1. Google Gemini API Configuration (Improvement 1: AI Brand Review)
# Required for server-side AI evaluation and evidence-backed checks.
# Obtain a key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model override (defaults to gemini-2.5-flash if unset)
# Options: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash

# 2. Local Development Server Port
# Default port for `npm start` / `node server.js`
PORT=5173

# 3. Supabase Integration (Improvement 2: Collaborative Governance & RBAC)
# Required for multi-user roles, draft collaboration, and audit trail persistence.
# Obtain credentials from your Supabase project dashboard: https://supabase.com/dashboard
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

